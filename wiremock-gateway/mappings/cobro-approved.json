{
  "name": "UC05 - Cobro aprobado (estado por defecto) POST /v1/payments",
  "priority": 10,
  "request": { "method": "POST", "urlPath": "/v1/payments" },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\":1234567890,\"status\":\"approved\",\"status_detail\":\"accredited\",\"transaction_amount\":{{jsonPath request.body '$.transaction_amount'}},\"external_reference\":\"{{jsonPath request.body '$.external_reference'}}\"}",
    "transformers": ["response-template"]
  }
}
