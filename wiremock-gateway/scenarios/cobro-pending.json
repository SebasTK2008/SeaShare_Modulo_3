{
  "name": "Escenario - Cobro pendiente",
  "priority": 1,
  "request": { "method": "POST", "urlPath": "/v1/payments" },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\":1234567890,\"status\":\"pending\",\"status_detail\":\"pending_waiting_payment\",\"transaction_amount\":{{jsonPath request.body '$.transaction_amount'}},\"external_reference\":\"{{jsonPath request.body '$.external_reference'}}\"}",
    "transformers": ["response-template"]
  }
}
