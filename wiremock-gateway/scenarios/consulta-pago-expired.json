{
  "name": "Escenario - Consulta de pago expirado",
  "priority": 1,
  "request": { "method": "GET", "urlPathPattern": "/v1/payments/[0-9]+" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\":{{request.pathSegments.[2]}},\"status\":\"expired\",\"status_detail\":\"expired\"}",
    "transformers": ["response-template"]
  }
}
