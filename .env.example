# Copiar a .env (ignorado por git) para el stack de docker-compose.
# Valores de ejemplo SOLO para desarrollo; en producción se aportan por entorno o Docker secrets.

# Infraestructura (docker-compose)
POSTGRES_DB=seashare
POSTGRES_USER=seashare
POSTGRES_PASSWORD=seashare
# Puerto de Postgres publicado en el host. Es 5433 porque el PostgreSQL nativo de Windows
# (servicio postgresql-x64-18) ya ocupa el 5432. Dentro de Docker la app usa postgres:5432.
POSTGRES_HOST_PORT=5433
RABBITMQ_USERNAME=seashare
RABBITMQ_PASSWORD=seashare

# Stub del Sistema de Gestion de Flota (WireMock) para las pruebas locales.
# Si no se levanta, UC01/UC02/UC03 responden 503 FLEET_UNAVAILABLE.
FLEET_STUB_PORT=8081

# Aplicacion (docker compose --profile app)
APP_PORT=8080
SEASHARE_TIMEZONE=America/Bogota
# URL de Flota vista desde la app: nombre del servicio y puerto INTERNO del contenedor.
FLEET_BASE_URL=http://fleet-stub:8080

# Pasarela de pago (Mercado Pago). Con el secret vacio el webhook responde 401 UNAUTHENTICATED.
GATEWAY_WEBHOOK_SECRET=
GATEWAY_ACCESS_TOKEN=
GATEWAY_COLLECTOR_ID=0

# Perfil prod (referencia; los valores reales nunca se versionan)
# DB_URL=jdbc:postgresql://postgres:5432/seashare
# DB_USERNAME=seashare
# DB_PASSWORD=change-me
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# FLEET_BASE_URL=http://fleet:8081
# GATEWAY_BASE_URL=https://api.mercadopago.com
# GATEWAY_ACCESS_TOKEN=change-me
# GATEWAY_WEBHOOK_SECRET=change-me
